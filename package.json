{
  "name": "ilot-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  },
  "version": "0.1.0",
  "overrides": {
    "braces": "^3.0.3",
    "node-forge": "^1.3.1",
    "uuid": "^11.1.1"
  }
}
